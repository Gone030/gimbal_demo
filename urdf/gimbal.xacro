<?xml version="1.0"?>
<robot name="gimbal_mani" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="inertial_box" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass/12.0*(y*y + z*z)}"
               ixy="0.0"
               ixz="0.0"
               iyy="${mass/12.0*(x*x + z*z)}"
               iyz="0.0"
               izz="${mass/12.0*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- base_link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.25 0.25 0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="1.0" x="0.25" y="0.25" z="0.05"/>
  </link>

  <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find gimbal_mani)/config/controller.yaml</parameters>
      </plugin>
  </gazebo>

  <link name="gimbal_base_link"/>

  <!-- yaw_link -->
  <link name="gimbal_yaw_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.5" x="0.1" y="0.1" z="0.05"/>
  </link>

  <!-- pitch_link -->
  <link name="gimbal_pitch_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="${pi/2} ${pi/2} 0.0"/>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.9 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.4" x="0.08" y="0.08" z="0.05"/>
  </link>

  <!-- camera_link -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.2" x="0.05" y="0.05" z="0.05"/>
  </link>

  <!-- camera_optical_frame -->
  <link name="camera_optical_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="yellow">
        <color rgba="1.0 1.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ========================= -->
  <!-- 3-DOF manipulator (arm)   -->
  <!-- base_link -> arm_link1 -> arm_link2 -> wrist_link -->
  <!-- ========================= -->

  <!-- arm_link1 -->
  <link name="arm_link1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.025"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.6" x="0.04" y="0.04" z="0.10"/>
  </link>

  <!-- arm_link2 -->
  <link name="arm_link2">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.018"/>
      </geometry>
      <material name="grey">
        <color rgba="0.55 0.55 0.55 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.16" radius="0.018"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.5" x="0.036" y="0.036" z="0.16"/>
  </link>

  <!-- wrist_link (end-effector mounting link) -->
  <link name="wrist_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="yellow">
        <color rgba="1.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.2" x="0.05" y="0.05" z="0.05"/>
  </link>

  <link name="wrist_mount_link"/>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="gripper_fixed_stick_link">
    <visual>
      <origin xyz="0.06 0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.01 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="gripper_moving_stick_link">
    <visual>
      <origin xyz="0.05 -0.01 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.01 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="wrist_to_wrist_mount" type="fixed">
    <parent link="wrist_link"/>
    <child link="wrist_mount_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- joint 1: base -> arm_link1 (yaw) -->
  <joint name="arm_joint1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="2.0"/>
  </joint>

  <!-- joint 2: arm_link1 -> arm_link2 (pitch) -->
  <joint name="arm_joint2" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.17" rpy="0 -1.570 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.7" friction="0.1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
  </joint>

  <!-- joint 3: arm_link2 -> wrist_link (pitch) -->
  <joint name="arm_joint3" type="revolute">
    <parent link="arm_link2"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.35" rpy="0 1.570 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.7" friction="0.1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
  </joint>

  <joint name="wriat_mount_to_gripper_base" type="fixed">
    <parent link="wrist_mount_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="-0.05 0 0" rpy="0 0 3.14"/>
  </joint>

  <joint name="gripper_fixed_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_fixed_stick_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_moving_stick_link"/>
    <origin xyz="0.01 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.6" effort="1.0" velocity="2.0"/>
  </joint>

  <joint name="gimbal_base_joint" type="fixed">
    <parent link="wrist_mount_link"/>
    <child link="gimbal_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 3.14"/>
  </joint>
  <!-- yaw joint (gimbal mounted on wrist_link) -->
  <joint name="gimbal_yaw_joint" type="revolute">
    <parent link="gimbal_base_link"/>
    <child link="gimbal_yaw_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="5.0" velocity="2.0"/>
  </joint>

  <!-- pitch joint -->
  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_yaw_link"/>
    <child link="gimbal_pitch_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.7" friction="0.1"/>
    <limit lower="-1.57" upper="0.5" effort="5.0" velocity="2.0"/>
  </joint>

  <!-- camera fixed -->
  <joint name="camera_fixed_joint" type="fixed">
    <parent link="gimbal_pitch_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>

  <!-- camera optical frame -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- ROS 카메라 표준 REP-103 optical frame 변환 -->
    <origin xyz="0.02 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Gazebo 카메라 센서 -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="gimbal_camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>

      <camera name="gimbal_cam">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/gimbal</namespace>
          <argument>image:=image_raw</argument>
          <argument>camera_info:=camera_info</argument>
        </ros>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
      <!-- <topic>camera/image_raw</topic> -->
    </sensor>
  </gazebo>



  <ros2_control name="GimbalSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="arm_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="arm_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="arm_joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gimbal_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gimbal_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <link name="tof_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.005"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/> <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="tof_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="tof_link"/>
    <origin xyz="0.025 0.0 -0.023" rpy="0 0 0"/>
  </joint>


  <gazebo reference="tof_link">
    <sensor type="ray" name="tof_sensor">
      <always_on>true</always_on>
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize> <update_rate>30</update_rate> <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle> <max_angle>0.01</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min> <max>2.0</max>  <resolution>0.01</resolution>
        </range>
        <radiation_type>infrared</radiation_type>
      </ray>

      <plugin name="tof_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/gimbal</namespace>
          <remapping>~/out:=tof_distance</remapping>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>

        <radiation_type>infrared</radiation_type>

        <frame_name>tof_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
