<?xml version="1.0"?>
<robot name="gimbal_mani"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="mesh_prefix" default=""/>
    <xacro:property name="mesh_prefix" value="$(arg mesh_prefix)"/>

    <link name="world"/>

    <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 1.57079632679"/>
    </joint>

    <!-- 고정 관찰 카메라 -->
    <link name="rear_top_camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="rear_cam_marker">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
    </link>
    <joint name="world_to_rear_top_camera" type="fixed">
        <parent link="base_link"/>
        <child link="rear_top_camera_link"/>
        <origin xyz="-0.5 0.4 0.6" rpy="0.0 0.55 -0.75"/>
    </joint>

    <!-- arm -->
    <xacro:include filename="$(find gimbal_mani)/urdf/so_100_arm_5dof.urdf.xacro"/>

    <!-- gimbal -->
    <xacro:include filename="$(find gimbal_mani)/urdf/gimbal.urdf.xacro"/>

    <!-- arm + gimbal 연결: mount(arm) -> base(gimbal) -->
    <joint name="arm_to_gimbal_joint" type="fixed">
        <parent link="gimbal_mount_link"/>
        <!-- arm 쪽에 존재 -->
        <child link="gimbal_base_link"/>
        <!-- gimbal 쪽에 존재 -->
        <origin xyz="0.002 0.004 0" rpy="3.1416 -1.5707 0"/>
    </joint>

    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>$(find gimbal_mani)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>


    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="Shoulder_Rotation">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="Shoulder_Pitch">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">-1.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="Elbow">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">1.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="Wrist_Pitch">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">-1.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="Wrist_Roll">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="Gripper">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="gimbal_yaw_servo_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="gimbal_pitch_servo_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>

    <gazebo reference="gimbal_camera_link">
        <sensor name="gimbal_camera" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <pose>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>50.0</far>
                </clip>
            </camera>

            <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/gimbal</namespace>
                </ros>
                <camera_name>camera</camera_name>
                <image_topic_name>image_raw</image_topic_name>
                <camera_info_topic_name>camera_info</camera_info_topic_name>
                <frame_name>gimbal_camera_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>
    <gazebo reference="tof_link">
        <sensor name="tof_ray" type="ray">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>false</visualize>

            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.02</min>
                    <max>2.00</max>
                    <resolution>0.001</resolution>
                </range>
            </ray>
            <plugin name="tof_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <namespace>/gimbal</namespace>
                    <remapping>~/out:=tof_distance</remapping>
                </ros>

                <output_type>sensor_msgs/LaserScan</output_type>

                <radiation_type>infrared</radiation_type>

                <frame_name>tof_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>
    <gazebo reference="rear_top_camera_link">
        <sensor name="rear_top_camera" type="camera">
            <always_on>true</always_on>
            <update_rate>15</update_rate>
            <pose>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100.0</far>
                </clip>
            </camera>
            <plugin name="gazebo_ros_rear_top_camera" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/overview</namespace>
                    <remapping>image_raw:=/overview/image_raw</remapping>
                    <remapping>camera_info:=/overview/camera_info</remapping>
                </ros>
                <camera_name>rear_top</camera_name>
                <image_topic_name>image_raw</image_topic_name>
                <camera_info_topic_name>camera_info</camera_info_topic_name>
                <frame_name>rear_top_camera_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
